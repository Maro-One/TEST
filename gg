import { useState, useEffect } from "react";
import { useSearchParams } from "react-router-dom";

const ProxyFetcher = () => {
  const [searchParams] = useSearchParams();
  const targetUrl = searchParams.get("url");
  const [data, setData] = useState(null);

  useEffect(() => {
    if (targetUrl) {
      fetch(targetUrl)
        .then((res) => res.text()) // Get response as text (or .json() if API)
        .then((text) => setData(text))
        .catch((err) => console.error("Error fetching:", err));
    }
  }, [targetUrl]);

  return (
    <div>
      <h2>Proxy Fetcher</h2>
      {data ? <pre>{data}</pre> : <p>Loading...</p>}
    </div>
  );
};

export default ProxyFetcher;

import ProxyFetcher from "./components/ProxyFetcher";

function App() {
  return (
    <div>
      <h1>React Proxy Example</h1>
      <ProxyFetcher />
    </div>
  );
}

export default App;

