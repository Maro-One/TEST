SELECT column_name, COUNT(*)
FROM table_name
GROUP BY column_name
HAVING COUNT(*) > 1;

package ocp.jfc2.dailymeeting.entities;

import com.fasterxml.jackson.annotation.JsonIgnore;
import com.fasterxml.jackson.annotation.JsonIgnoreProperties;
import com.fasterxml.jackson.annotation.JsonProperty;
import lombok.*;
import ocp.jfc2.dailymeeting.entities.indicators.AffectationKPI;
import org.hibernate.annotations.CreationTimestamp;
import org.hibernate.annotations.NotFound;
import org.hibernate.annotations.NotFoundAction;
import org.hibernate.annotations.Type;
import org.hibernate.annotations.UpdateTimestamp;

import javax.persistence.Column;
import javax.persistence.Entity;
import javax.persistence.EnumType;
import javax.persistence.Enumerated;
import javax.persistence.FetchType;
import javax.persistence.GeneratedValue;
import javax.persistence.GenerationType;
import javax.persistence.Id;
import javax.persistence.JoinColumn;
import javax.persistence.Lob;
import javax.persistence.ManyToOne;
import javax.persistence.OneToMany;
import javax.persistence.Transient;
import java.util.Date;
import java.util.List;

@Data
@Entity
@AllArgsConstructor
@NoArgsConstructor
@ToString
@JsonIgnoreProperties
@Getter
public class Task {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    private Long id;

    private String title;

    private Date deadline;

    private boolean done = false;

    private Date closeDate;

    private Boolean withMultipleKpis;

    @CreationTimestamp
    private Date creationDate;

    @UpdateTimestamp
    private Date updateDate;

    @Enumerated(EnumType.STRING)
    private TaskStatus status = TaskStatus.NEW;

    @Enumerated(EnumType.STRING)
    private TaskSubCategory subcategory;

    @Lob
    @Column(nullable = false, length = 65535, columnDefinition = "TEXT")
    private String description;

    @Type(type = "org.hibernate.type.NumericBooleanType")
    @Column(nullable = true)
    private boolean autorisationTravail;

    @Type(type = "org.hibernate.type.NumericBooleanType")
    @Column(nullable = false)
    private boolean travauxHauteur;

    @Type(type = "org.hibernate.type.NumericBooleanType")
    @Column(nullable = false)
    private boolean espaceConfine;

    @Type(type = "org.hibernate.type.NumericBooleanType")
    @Column(nullable = false)
    private boolean permisFeu;

    @Type(type = "org.hibernate.type.NumericBooleanType")
    @Column(nullable = false)
    private boolean consignationEnergie;

    @ManyToOne(fetch = FetchType.LAZY)
    @JoinColumn(name = "anomaly_id")
    @JsonIgnore
    private Anomaly anomaly;

    // to remove, used for sending data to front
    @JsonProperty("anomalyId")
    public Long getXXX() {
        return anomaly == null ? null : anomaly.getId();
    }

    @ManyToOne(fetch = FetchType.LAZY)
    @JoinColumn(name = "user_id")
    @NotFound(action = NotFoundAction.IGNORE)
    @JsonIgnore
    private User user;

    @ManyToOne(fetch = FetchType.LAZY)
    @JoinColumn(name = "created_by")
    @JsonIgnore
    private User createdBy;

    @Enumerated(EnumType.STRING)
    private TaskSource source = TaskSource.ANOMALY;

    @ManyToOne(fetch = FetchType.LAZY)
    @JoinColumn(name = "atelier_id")
    @JsonIgnore
    private Atelier atelier;

    @ManyToOne(fetch = FetchType.LAZY)
    @JoinColumn(name = "affectation_kpi_id")
    @JsonIgnore
    private AffectationKPI affectationKpi;

    @OneToMany(
        mappedBy = "task",
        fetch = FetchType.LAZY
    )
    private List<TaskDeadline> taskDeadlines;


    @Transient
    private Long reportedCount;

    public Long getReportedCount() {
        if (taskDeadlines != null && !taskDeadlines.isEmpty()) {
            return taskDeadlines.stream().count() - 1;
        } else {
            return 0L;
        }
    }
}
