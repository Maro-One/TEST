const renderMultiSelectWithCheckbox = ({
  input,
  label,
  options = [],
  meta: { touched, error },
}) => {
  const selectedLabels = options
    .filter((opt) => input.value?.includes(opt.id))
    .map((opt) => opt.name)
    .join(', ');

  return (
    <FormControl fullWidth margin="normal" error={touched && !!error}>
      <InputLabel>{label}</InputLabel>
      <Select
        multiple
        value={input.value || []}
        onChange={(event) => input.onChange(event.target.value)}
        renderValue={() => selectedLabels}
      >
        {options.map((option) => (
          <MenuItem key={option.id} value={option.id}>
            <Checkbox checked={(input.value || []).includes(option.id)} />
            <ListItemText primary={option.name} />
          </MenuItem>
        ))}
      </Select>
    </FormControl>
  );
};

  renderValue={(selected) => {
    if (!selected || selected.length === 0) {
      return 'Please select menus'; // ✅ default string
    }
    const selectedLabels = options
      .filter((opt) => selected.includes(opt.id))
      .map((opt) => opt.name)
      .join(', ');
    return selectedLabels;
  }}
